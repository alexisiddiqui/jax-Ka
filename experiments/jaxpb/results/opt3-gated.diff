+def cpu_available():
+    """The scalar ref-tree lowering has been gated on this CPU/XLA runtime.
+
+    Other runtimes retain mc_ref, rather than assuming its floating reduction
+    tree is portable. No probe compilation or per-state executable is needed.
+    """
+    import os
+    import platform
+    from pathlib import Path
+
+    if jax.__version__ != '0.11.1' or platform.system() != 'Linux' or platform.machine() != 'x86_64':
+        return False
+    if any(x in os.environ.get('XLA_FLAGS', '') for x in ('xla_cpu_prefer_vector_width', 'xla_cpu_enable_fast_math')):
+        return False
+    try:
+        return 'avx2' in Path('/proc/cpuinfo').read_text().split()
+    except OSError:
+        return False
