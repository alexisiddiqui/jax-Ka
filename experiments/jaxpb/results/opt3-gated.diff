+def _cpu_pair_energy(E, na, oa, nb, ob):
+    """Prune the validated CPU ref tree for two sites of at most eight states.
+
+    On the validated CPU runtime, each SIMD lane sees at most two nonzeros
+    from sites of <=8 microstates, so its accumulation reduces to one add.
+    Halves folding visits leaves in bit-reversed index order. Sorting four
+    leaves by that order and their common prefixes recovers its three-add
+    tree, including missing (zero) subtrees. A scalar jnp.sum lowers to a
+    different tree on CPU and can flip rare acceptances at 200k sweeps.
+    Same-site proposals cancel inside their original cell before reduction.
+    """
+    zero = jnp.float32(0)
+    values = jnp.stack((jnp.where(na == oa, zero, E[na]), jnp.where(na == oa, zero, -E[oa]),
+                        jnp.where(nb == ob, zero, E[nb]), jnp.where(nb == ob, zero, -E[ob])))
+    rank = jnp.stack((na, oa, nb, ob)).astype(jnp.uint32)
+    for shift, mask in ((1, 0x55555555), (2, 0x33333333), (4, 0x0f0f0f0f), (8, 0x00ff00ff)):
+        rank = ((rank >> shift) & jnp.uint32(mask)) | ((rank & jnp.uint32(mask)) << shift)
+    rank = (rank >> 16) | (rank << 16)
+    def swap(ka, va, kb, vb):
+        flip = ka > kb
+        return jnp.where(flip, kb, ka), jnp.where(flip, vb, va), jnp.where(flip, ka, kb), jnp.where(flip, va, vb)
+    k0, k1, k2, k3 = rank[0], rank[1], rank[2], rank[3]
+    a, b, c, d = values[0], values[1], values[2], values[3]
+    k0, a, k1, b = swap(k0, a, k1, b)
+    k2, c, k3, d = swap(k2, c, k3, d)
+    k0, a, k2, c = swap(k0, a, k2, c)
+    k1, b, k3, d = swap(k1, b, k3, d)
+    k1, b, k2, c = swap(k1, b, k2, c)
+    ab = lax.optimization_barrier(a + b)
+    bc = lax.optimization_barrier(b + c)
+    cd = lax.optimization_barrier(c + d)
+    l01 = lax.clz(k0 ^ k1); l12 = lax.clz(k1 ^ k2); l23 = lax.clz(k2 ^ k3)
+
+    def first(_):
+        tail = lax.cond(l12 < l23, lambda _: lax.optimization_barrier(b + cd),
+                        lambda _: lax.optimization_barrier(bc + d), None)
+        return a + tail
+
+    def last(_):
+        head = lax.cond(l01 < l12, lambda _: lax.optimization_barrier(a + bc),
+                        lambda _: lax.optimization_barrier(ab + c), None)
+        return head + d
+
+    return lax.cond(l12 < jnp.minimum(l01, l23), lambda _: ab + cd,
+                    lambda _: lax.cond(l01 < l23, first, last, None), None)
